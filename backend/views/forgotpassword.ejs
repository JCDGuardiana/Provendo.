<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/assets/provendo_icon.png" />
    <link rel="stylesheet" href="/dist/output.css" />
    <title>Forgot Password | Provendo</title>
  </head>
  <body class="m-0 flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-xl">
      <div
        class="min-h-[500px] rounded-xl border border-gray-300 p-10 shadow-lg"
      >
        <!-- Step dots -->
        <div id="dots" class="mb-6 flex items-center justify-center gap-2">
          <span class="h-2 w-8 rounded-full bg-primary"></span>
          <span class="h-2 w-8 rounded-full bg-gray-300"></span>
          <span class="h-2 w-8 rounded-full bg-gray-300"></span>
        </div>

        <!-- STEP 1: email -->
        <section data-step="1">
          <img
            src="/assets/reset-password.svg"
            alt=""
            class="mx-auto size-28"
          />
          <h1 class="font-tilt-neon mt-5 text-lg font-bold tracking-widest">
            Forgot Password
          </h1>
          <p class="font-open-sans text-sm">
            No worries, we'll send you reset instructions
          </p>

          <form id="emailForm" class="mt-4">
            <input
              type="email"
              id="email"
              placeholder="Enter your email"
              autocomplete="email"
              required
              class="w-full rounded-md border border-gray-300 p-3 focus:outline-2 focus:outline-primary"
            />
            <button
              type="submit"
              class="font-open-sans mt-5 flex w-full cursor-pointer items-center justify-center rounded-lg bg-primary p-2 text-sm font-semibold text-white"
            >
              Send reset instructions
            </button>
          </form>
        </section>

        <!-- STEP 2: 6-digit code -->
        <section data-step="2" class="hidden">
          <h1 class="font-tilt-neon mt-5 text-lg font-bold tracking-widest">
            Enter Code
          </h1>
          <p class="font-open-sans text-sm">
            We sent a 6-digit code to <strong id="emailShown"></strong>
          </p>

          <form id="codeForm" class="mt-4">
            <div class="flex justify-center gap-2">
              <input
                type="text"
                inputmode="numeric"
                maxlength="1"
                aria-label="Digit 1"
                autocomplete="one-time-code"
                class="code-box size-12 rounded-md border border-gray-300 text-center text-lg focus:outline-2 focus:outline-primary"
              />
              <input
                type="text"
                inputmode="numeric"
                maxlength="1"
                aria-label="Digit 2"
                class="code-box size-12 rounded-md border border-gray-300 text-center text-lg focus:outline-2 focus:outline-primary"
              />
              <input
                type="text"
                inputmode="numeric"
                maxlength="1"
                aria-label="Digit 3"
                class="code-box size-12 rounded-md border border-gray-300 text-center text-lg focus:outline-2 focus:outline-primary"
              />
              <input
                type="text"
                inputmode="numeric"
                maxlength="1"
                aria-label="Digit 4"
                class="code-box size-12 rounded-md border border-gray-300 text-center text-lg focus:outline-2 focus:outline-primary"
              />
              <input
                type="text"
                inputmode="numeric"
                maxlength="1"
                aria-label="Digit 5"
                class="code-box size-12 rounded-md border border-gray-300 text-center text-lg focus:outline-2 focus:outline-primary"
              />
              <input
                type="text"
                inputmode="numeric"
                maxlength="1"
                aria-label="Digit 6"
                class="code-box size-12 rounded-md border border-gray-300 text-center text-lg focus:outline-2 focus:outline-primary"
              />
            </div>

            <p
              id="codeError"
              class="mt-3 hidden text-center text-sm text-red-600"
            ></p>

            <button
              type="submit"
              class="font-open-sans mt-5 flex w-full cursor-pointer items-center justify-center rounded-lg bg-primary p-2 text-sm font-semibold text-white"
            >
              Verify code
            </button>

            <div class="mt-4 flex justify-between text-sm text-gray-600">
              <button
                type="button"
                id="backToEmail"
                class="cursor-pointer hover:text-black"
              >
                Back
              </button>
              <button
                type="button"
                id="resend"
                class="cursor-pointer hover:text-black"
              >
                Resend code
              </button>
            </div>
          </form>
        </section>

        <section data-step="3" class="hidden">
          <h1 class="font-tilt-neon mt-5 text-lg font-bold tracking-widest">
            New Password
          </h1>
          <p class="font-open-sans text-sm">
            Choose a new password for your account
          </p>

          <form id="passwordForm" class="mt-4 space-y-3">
            <input
              type="password"
              id="pw1"
              placeholder="New password"
              minlength="8"
              required
              autocomplete="new-password"
              class="w-full rounded-md border border-gray-300 p-3 focus:outline-2 focus:outline-primary"
            />
            <input
              type="password"
              id="pw2"
              placeholder="Confirm new password"
              minlength="8"
              required
              autocomplete="new-password"
              class="w-full rounded-md border border-gray-300 p-3 focus:outline-2 focus:outline-primary"
            />
            <p id="pwError" class="hidden text-center text-sm text-red-600"></p>
            <button
              type="submit"
              class="font-open-sans mt-2 flex w-full cursor-pointer items-center justify-center rounded-lg bg-primary p-2 text-sm font-semibold text-white"
            >
              Reset password
            </button>
          </form>
        </section>
      </div>
    </div>
  </body>
</html>
