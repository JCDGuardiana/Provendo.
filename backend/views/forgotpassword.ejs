<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/assets/provendo_icon.png" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
      integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/dist/output.css" />
    <title>forgotpassword</title>
  </head>
  <body class="min-w-screen min-h-screen flex align-center justify-center">
    <div
      class="content-container flex flex-col align-center justify-center gap-4 p-4"
    >
      <div
        class="min-w-xl min-h-[500px] flex flex-col align-center p-10 border border-gray-300 rounded-xl shadow-lg"
      >
        <div class="flex flex-col justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            width="70"
            height="70"
            class="text-primary block mx-auto p-2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
            />
          </svg>
          <h1 class="font-tilt-neon font-bold text-lg tracking-widest mt-5">
            Forgot Password
          </h1>
          <p class="font-open-sans text-sm">
            No worries, we'll send you reset instructions
          </p>

          <div class="form-container flex flex-col gap-4 mt-4">
            <form id="forms" class="">
              <input
                type="email"
                name="email"
                placeholder="Enter your email"
                id="email"
                required
                class="border border-gray-300 p-3 rounded-md w-full"
              />
              <button
                class="w-full cursor-pointer bg-primary p-2 rounded-lg mt-5 text-white text-sm flex text-center justify-center gap-2 items-center font-open-sans font-semibold"
              >
                Send reset instructions
                <span
                  ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-6 gap-2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
                    />
                  </svg>
                </span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <div class="pagination-container"></div>
  </body>
</html>
