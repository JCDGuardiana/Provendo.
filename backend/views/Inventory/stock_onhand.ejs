<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href="/assets/provendo_icon.png" />
    <link
      href="https://fonts.googleapis.com/css2?family=Boldonse&family=Fragment+Mono:ital@0;1&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Tilt+Neon&family=Tilt+Warp&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
      integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/css/output.css" />
    <title>Stock Onhand</title>
  </head>
  <body class="flex min-h-screen bg:gray-100">
    <%- include("../partials/sidenavbar") %>
    <div class="main-container flex-1">
      <div class="h-15.5 p-5">
        <h1 class="title-page">
          Inventory / <b class="font-fragment-mono">Stock Onhand</b>
        </h1>
      </div>

      <div class="main-content p-6">
        <div
          class="toolbar max-w-7xl mx-auto flex justify-between items-center gap-4 bg-bg-accent p-5 rounded-lg shadow-sm border border-primary"
        >
          <div class="search-wrapper flex flex-col gap-2 font-fragment-mono">
            <label
              for="Search product"
              class="font-tilt-warp text-md tracking-widest text-primary"
              >Search by code or name</label
            >
            <input
              id="search-product"
              type="text"
              placeholder="Search by code or name"
              class="border border-primary rounded p-2.5 w-100 text-gray tracking-0"
            />
          </div>
          <div class="add-button-wrapper">
            <button
              class="flex items-center gap-2 bg-blue-900 text-white px-4 py-2 rounded-lg font-medium cursor-pointer font-fragment-mono"
              id="add_button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4.5v15m7.5-7.5h-15"
                />
              </svg>
              <span>Add product</span>
            </button>
          </div>
        </div>

        <div
          class="table-wrapper p-4 bg-white rounded-lg mt-6 border border-primary drop-shadow-lg max-h-[60vh] overflow-y-auto"
        >
          <table
            class="table-auto md:table-fixed w-full text-center border-separate border-spacing-y-1"
          >
            <thead
              class="uppercase p-2 [&_th:nth-child(odd)]:bg-primary [&_th:nth-child(odd)]:text-white [&_th:nth-child(even)]:bg-gray-100 font-fragment-mono text-sm"
            >
              <tr>
                <th class="p-4 sticky top-0">Id</th>
                <th class="p-4 sticky top-0">Product name</th>
                <th class="p-4 sticky top-0">Product code</th>
                <th class="p-4 sticky top-0">Unit</th>
                <th class="p-4 sticky top-0">Stocks</th>
                <th class="p-4 sticky top-0">Cost price</th>
                <th class="p-4 sticky top-0">Selling price</th>
                <th class="p-4 sticky top-0">Reorder level</th>
                <th class="p-4 sticky top-0">Actions</th>
              </tr>
            </thead>
            <tbody
              id="product_table"
              class="font-fragment-mono text-sm text-center [&_tr:nth-child(odd)]:bg-gray-300 [&_tr:nth-child(odd)]:text-black [&_tr:nth-child(even)]:bg-white [&_tr:nth-child(even)]:text-primary"
            ></tbody>
          </table>
        </div>

        <div class="error-msg" id="errormsg"></div>
        <div class="success-msg" id="successmsg"></div>
      </div>

      <div
        class="form-modal hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4 text-accent-text"
        id="form-modal"
      >
        <div
          class="form-wrapper flex h-150 max-h-full w-200 max-w-full flex-col rounded-md bg-white p-4"
        >
          <div class="form-title flex items-center justify-between p-4">
            <h1 class="font-tilt-warp text-lg text-primary" id="modal-title">
              Add product
            </h1>
            <button
              type="button"
              class="close-btn cursor-pointer"
              id="cls-btn"
              aria-label="Close"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-7"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 18 18 6M6 6l12 12"
                />
              </svg>
            </button>
          </div>

          <div class="add-product-form-container min-h-0 flex-1 p-4">
            <form
              id="add-product-form"
              action="/inventory/add_product"
              method="POST"
              class="flex h-full flex-col gap-5"
            >
              <div class="grid grid-cols-2 gap-5">
                <div class="input-container flex flex-col gap-1">
                  <label for="product_name">Product name</label>
                  <input
                    type="text"
                    id="product_name"
                    name="product_name"
                    class="rounded-md border border-gray-300 px-3 py-2"
                  />
                </div>
                <div class="input-container flex flex-col gap-1">
                  <label for="product_code">Product code</label>
                  <input
                    type="text"
                    id="product_code"
                    name="product_code"
                    class="rounded-md border border-gray-300 px-3 py-2"
                  />
                </div>
              </div>

              <div class="grid grid-cols-2 gap-5">
                <div class="input-container flex flex-col gap-1">
                  <label for="unit">Unit</label>
                  <input
                    type="text"
                    id="unit"
                    name="product_unit"
                    class="rounded-md border border-gray-300 px-3 py-2"
                  />
                </div>
                <div class="input-container flex flex-col gap-1">
                  <label for="stocks">Stocks</label>
                  <input
                    type="number"
                    id="stocks"
                    name="stocks"
                    min="0"
                    class="rounded-md border border-gray-300 px-3 py-2"
                  />
                </div>
              </div>

              <div class="grid grid-cols-2 gap-5">
                <div class="input-container flex flex-col gap-1">
                  <label for="cost_price">Product cost price</label>
                  <input
                    type="number"
                    id="product_cost_price"
                    name="product_cost_price"
                    min="0"
                    step="0.01"
                    class="rounded-md border border-gray-300 px-3 py-2"
                  />
                </div>
                <div class="input-container flex flex-col gap-1">
                  <label for="price">Selling price</label>
                  <input
                    type="number"
                    id="price"
                    name="product_price"
                    min="0"
                    step="0.01"
                    class="rounded-md border border-gray-300 px-3 py-2"
                  />
                </div>
              </div>

              <div class="grid grid-cols-2 gap-5">
                <div class="input-container flex flex-col gap-1">
                  <label for="reorder">Reorder level</label>
                  <input
                    type="number"
                    id="reorder"
                    name="product_reorder_level"
                    min="0"
                    class="rounded-md border border-gray-300 px-3 py-2"
                  />
                </div>
              </div>

              <div
                class="button-container mt-auto flex justify-end gap-3 border-t border-gray-200 pt-4"
              >
                <button
                  type="button"
                  id="cancel-btn"
                  class="rounded-md border border-gray-300 px-5 py-2 hover:bg-gray-50 cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  id="submit"
                  class="rounded-md bg-primary px-5 py-2 font-medium text-white hover:opacity-90"
                >
                  Add
                </button>
              </div>
            </form>

            <div class="modal-error-msg"></div>
            <div class="modal-success-msg"></div>
          </div>
        </div>
      </div>
    </div>

    <script src="/js/modal.js"></script>
    <script src="/js/sidebar.js"></script>
  </body>
</html>
